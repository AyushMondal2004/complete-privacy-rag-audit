# Local LLM server (Ollama default). Change if using LM Studio / another runner.
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Embedding model (sentence-transformers, downloaded once, runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Where the vector DB persists to disk
CHROMA_PERSIST_DIR=./data/processed/chroma
